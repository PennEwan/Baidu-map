# Server-side AK only. Copy to .env locally; never commit .env.
BAIDU_MAP_AK=
# baidu requires both a server AK and an explicitly configured QPS.
# Use synthetic for offline integration; no real routing requests are sent.
# ANALYSIS_QPS is local pacing, not a console quota. Confirm walking
# (directionlite) and optional routematrix OD/s + daily limits in the
# Baidu console before any live baseline; B1 poi_collect uses its own qps.
ANALYSIS_PROVIDER=baidu
ANALYSIS_QPS=
# JSON array of exact origins, without trailing slashes.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Independent offline OSM engine; paths are relative to backend.
# Preparing a new snapshot requires an explicit version and matching coverage.
OSM_PBF_PATH=../data/osm/shanghai-260912.osm.pbf
OSM_GRAPH_CACHE_PATH=../data/osm/shanghai.osm-cache
OSM_DATA_VERSION=geofabrik-shanghai-20260912
OSM_METRIC_CRS=EPSG:32651
WALK_SPEED_MPS=1.3
SNAP_MAX_DISTANCE_M=200
ISOCHRONE_BUFFER_M=25
OSM_COVERAGE_BOUNDARY_PATH=../data/osm/shanghai.poly
OSM_COVERAGE_MARGIN_M=100
